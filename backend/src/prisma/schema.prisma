datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FOUNDER
  RECRUITER
  ADMIN
}

enum Availability {
  AVAILABLE_NOW
  OPEN_TO_PROJECTS
  INTERNSHIP
  BUSY
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OpportunityType {
  FREELANCE_GIG
  STARTUP_PROJECT
  INTERNSHIP
  HACKATHON
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_CAMPUS
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEWING
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  RECRUITING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ChatType {
  DIRECT
  TEAM
  STARTUP
}

enum NotificationType {
  NEW_MESSAGE
  TEAM_INVITE
  APPLICATION_STATUS
  REVIEW_RECEIVED
  MATCH
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum AdminLevel {
  MODERATOR
  SUPERADMIN
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  role            Role           @default(STUDENT)
  isVerified      Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  profile         Profile?
  applications    Application[]
  opportunities   Opportunity[]
  memberships     TeamMember[]
  teamsLed        Team[]
  assignedTasks   Task[]
  chats           ChatParticipant[]
  sentMessages    Message[]
  notifications   Notification[]
  sentReviews     Review[]       @relation("SentReviews")
  receivedReviews Review[]       @relation("ReceivedReviews")
  posts           Post[]
  comments        Comment[]
  uploadedFiles   File[]
  activityLogs    ActivityLog[]
  sentReports     Report[]       @relation("Reporter")
  receivedReports Report[]       @relation("ReportedUser")
  adminProfile    Admin?
  bookmarks       Bookmark[]
  likes           PostLike[]
}

model Profile {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  username       String         @unique
  headline       String?
  university     String?
  degree         String?
  gradYear       String?
  availability   Availability   @default(OPEN_TO_PROJECTS)
  bio            String?
  avatarGradient String?        @default("from-blue-600 to-indigo-600")
  bannerGradient String?        @default("from-slate-900 via-blue-900/40 to-slate-900")
  avatarUrl      String?
  bannerUrl      String?
  reputation     Float          @default(5.0)
  collabScore    Float          @default(100.0)
  profileViews   Int            @default(0)
  github         String?
  twitter        String?
  portfolioUrl   String?
  badges         String[]
  skills         Skill[]
  portfolios     Portfolio[]
  experiences    Experience[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Skill {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  level      Level    @default(INTERMEDIATE)
  endorsements Int    @default(0)
  
  @@index([profileId])
}

model Portfolio {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  type        String
  description String
  tech        String[]
  metrics     String?
  link        String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([profileId])
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role        String
  company     String
  date        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([profileId])
}

model Opportunity {
  id               String          @id @default(cuid())
  creatorId        String
  creator          User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  budget           String
  tags             String[]
  clientName       String
  clientReputation Float           @default(5.0)
  deadline         DateTime
  projectType      OpportunityType @default(STARTUP_PROJECT)
  duration         String
  teamSizeNeeded   Int             @default(1)
  workMode         WorkMode        @default(REMOTE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  applications     Application[]
  reports          Report[]
  bookmarks        Bookmark[]
  
  @@index([creatorId])
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantId   String
  applicant     User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(APPLIED)
  proposal      String?
  resumeUrl     String?
  githubLink    String?
  otherLinks    String[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  @@unique([opportunityId, applicantId])
  @@index([opportunityId])
  @@index([applicantId])
}

model Team {
  id          String        @id @default(cuid())
  name        String
  description String?
  leadId      String
  lead        User          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      ProjectStatus @default(RECRUITING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  members     TeamMember[]
  tasks       Task[]
  files       File[]
  
  @@index([leadId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("Member")
  joinedAt DateTime @default(now())
  
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  teamId      String
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  assignee    User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  @@index([teamId])
  @@index([assigneeId])
}

model Chat {
  id             String            @id @default(cuid())
  type           ChatType          @default(DIRECT)
  name           String?
  avatarGradient String?
  avatarText     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  participants   ChatParticipant[]
  messages       Message[]
}

model ChatParticipant {
  id         String   @id @default(cuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unreadCount Int      @default(0)
  lastReadAt DateTime @default(now())
  
  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
}

model Message {
  id          String              @id @default(cuid())
  chatId      String
  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text        String
  timestamp   DateTime            @default(now())
  replyToId   String?
  replyTo     Message?            @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]           @relation("MessageReplies")
  reactions   Json?
  
  attachments MessageAttachment[]
  files       File[]
  
  @@index([chatId])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  size      String
  type      String
  url       String
  
  @@index([messageId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  
  @@index([userId])
}

model Review {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation("SentReviews", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ReceivedReviews", fields: [targetUserId], references: [id], onDelete: Cascade)
  text         String
  rating       Int      @default(5)
  createdAt    DateTime @default(now())
  
  @@index([authorId])
  @@index([targetUserId])
}

model Community {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  posts       Post[]
  createdAt   DateTime @default(now())
}

model Post {
  id            String     @id @default(cuid())
  communityId   String
  community     Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  content       String
  likesCount    Int        @default(0)
  commentsCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  comments      Comment[]
  files         File[]
  bookmarks     Bookmark[]
  likes         PostLike[]
  
  @@index([communityId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())
  
  @@index([postId])
  @@index([userId])
}

model File {
  id         String   @id @default(cuid())
  name       String
  size       String
  type       String
  url        String
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messageId  String?
  message    Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  
  @@index([uploaderId])
  @@index([teamId])
  @@index([messageId])
  @@index([postId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model Report {
  id                  String       @id @default(cuid())
  reporterId          String
  reporter            User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId        String?
  reportedUser        User?        @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetPostId        String?
  targetOpportunityId String?
  reportedOpportunity Opportunity? @relation(fields: [targetOpportunityId], references: [id], onDelete: Cascade)
  reason              String
  status              ReportStatus @default(PENDING)
  createdAt           DateTime     @default(now())
  
  @@index([reporterId])
  @@index([targetUserId])
}

model Admin {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  level      AdminLevel @default(MODERATOR)
  privileges String[]
  createdAt  DateTime   @default(now())
}

model Bookmark {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId        String?
  post          Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([userId, postId, opportunityId])
  @@index([userId])
  @@index([postId])
  @@index([opportunityId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}
