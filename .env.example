# ==============================================================================
# HUSTLR - Core Platform Environment Settings (Example)
# ==============================================================================

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# --- Database (PostgreSQL & Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hustlr?schema=public"

# --- Security & JWT (JSON Web Tokens) ---
# Secrets should be 256-bit cryptographically secure strings
JWT_ACCESS_SECRET="your_cryptographic_access_token_secret_here_32_chars_min"
JWT_REFRESH_SECRET="your_cryptographic_refresh_token_secret_here_64_chars_min"

# --- Cookie Settings (Refresh Token Session Management) ---
# MaxAge for cookies (corresponds to refresh token 7-day duration in ms)
COOKIE_MAX_AGE=604800000

# --- Cloudinary Settings (Media Uploads) ---
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# --- AI Career Engine (Gemini / LLM API Key) ---
GEMINI_API_KEY="your_google_gemini_api_key_here"

# --- Logging Control ---
LOG_LEVEL=info
